---
import TemplateManager from './TemplateManager.astro';
import HistoryManager from './HistoryManager.astro';
---

<div id="burger-menu-overlay" class="burger-menu-overlay hidden"></div>

<div id="burger-menu-drawer" class="burger-menu-drawer">
  <div class="drawer-header">
    <h2>Menu</h2>
    <button id="close-burger-menu" class="btn-icon" aria-label="Tutup Menu">
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="drawer-content">
    <!-- Account Card -->
    <div class="account-card" id="account-card">
      <div id="auth-loading" class="text-center text-muted" style="font-size: 0.9rem; padding: 1rem;">
        Memuat sesi...
      </div>
      
      <!-- Unauthenticated State -->
      <div id="unauth-state" class="hidden">
        <p class="account-desc">Masuk untuk menyimpan data Anda dengan aman di cloud.</p>
        <div class="auth-buttons">
          <button id="btn-login-google" class="btn btn-auth google-auth">
            <svg viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Masuk dengan Google
          </button>
        </div>
      </div>

      <!-- Authenticated State -->
      <div id="auth-state" class="hidden">
        <div class="profile-info">
          <img id="user-avatar" src="" alt="Avatar" class="avatar-img" />
          <div class="profile-text">
            <span id="user-name" class="user-name">Pengguna</span>
            <span id="user-email" class="user-email">email@domain.com</span>
          </div>
        </div>
        <button id="btn-logout" class="btn btn-secondary btn-logout">
          Keluar
        </button>
      </div>
    </div>

    <!-- Theme Toggle -->
    <div class="menu-item-row">
      <span class="menu-item-label">Tema Tampilan</span>
      <button id="burger-theme-toggle" class="btn btn-secondary btn-icon theme-btn" aria-label="Toggle theme">
        🌙
      </button>
    </div>

    <hr class="menu-divider" />

    <!-- Feature Managers inside Menu -->
    <div class="menu-managers">
      <TemplateManager />
      <HistoryManager />
    </div>

  </div>
</div>

<style is:global>
  .burger-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(3px);
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .burger-menu-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .burger-menu-drawer {
    position: fixed;
    top: 0;
    right: -100%;
    width: 100%;
    max-width: 400px;
    height: 100%;
    background-color: var(--bg-surface-solid);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    z-index: 1001;
    transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .burger-menu-drawer.active {
    right: 0;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    background-color: var(--bg-surface-solid);
    z-index: 10;
  }
  
  .drawer-header h2 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
  }

  .drawer-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Account Card Styles */
  .account-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .account-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-align: center;
  }

  .auth-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .btn-auth {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    background-color: var(--bg-surface-solid);
    color: var(--text-primary);
    border: 1px solid var(--border-color-solid);
    font-weight: 600;
  }
  .btn-auth:hover {
    background-color: var(--border-color);
  }

  .profile-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .avatar-img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--border-color);
    object-fit: cover;
  }

  .profile-text {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .user-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .user-email {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .btn-logout {
    width: 100%;
    color: var(--color-danger);
    background-color: rgba(239, 68, 68, 0.1);
    border: none;
  }
  .btn-logout:hover {
    background-color: var(--color-danger);
    color: white;
  }

  /* Theme row */
  .menu-item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 0.5rem;
  }
  .menu-item-label {
    font-weight: 600;
    color: var(--text-primary);
  }

  .menu-divider {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: 0;
  }

  .menu-managers {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  /* Reset some inner paddings for managers since they are inside the drawer */
  .menu-managers .template-manager, .menu-managers .history-manager {
    margin-bottom: 0;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  // --- Burger Menu Logic ---
  const overlay = document.getElementById('burger-menu-overlay');
  const drawer = document.getElementById('burger-menu-drawer');
  const closeBtn = document.getElementById('close-burger-menu');
  
  // Expose toggle globally
  (window as any).toggleBurgerMenu = () => {
    const isActive = drawer.classList.contains('active');
    if (isActive) {
      drawer.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    } else {
      drawer.classList.add('active');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  };

  closeBtn.addEventListener('click', (window as any).toggleBurgerMenu);
  overlay.addEventListener('click', (window as any).toggleBurgerMenu);

  // --- Theme Toggle Logic in Burger ---
  const burgerThemeBtn = document.getElementById('burger-theme-toggle');
  
  function updateThemeIcon() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    if (burgerThemeBtn) {
      burgerThemeBtn.textContent = isDark ? '☀️' : '🌙';
    }
  }

  if (burgerThemeBtn) {
    updateThemeIcon(); // init
    burgerThemeBtn.addEventListener('click', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      if (currentTheme === 'dark') {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
      }
      updateThemeIcon();
    });
  }

  // --- Supabase Auth Logic ---
  const authLoading = document.getElementById('auth-loading');
  const unauthState = document.getElementById('unauth-state');
  const authState = document.getElementById('auth-state');
  
  const userName = document.getElementById('user-name');
  const userEmail = document.getElementById('user-email');
  const userAvatar = document.getElementById('user-avatar');
  
  const btnGoogle = document.getElementById('btn-login-google');
  const btnLogout = document.getElementById('btn-logout');

  async function checkSession() {
    const { data: { session } } = await supabase.auth.getSession();
    renderSession(session);
  }

  function renderSession(session) {
    authLoading.classList.add('hidden');
    const headerGreeting = document.getElementById('header-greeting');
    
    if (session && session.user) {
      unauthState.classList.add('hidden');
      authState.classList.remove('hidden');
      
      const meta = session.user.user_metadata;
      const fullName = meta.full_name || 'Pengguna';
      userName.textContent = fullName;
      userEmail.textContent = session.user.email || '';
      (userAvatar as HTMLImageElement).src = meta.avatar_url || `https://ui-avatars.com/api/?name=${encodeURIComponent(fullName)}&background=random`;
      
      if (headerGreeting) {
        const firstName = fullName.split(' ')[0];
        headerGreeting.textContent = `Halo, ${firstName}! 👋`;
      }
    } else {
      authState.classList.add('hidden');
      unauthState.classList.remove('hidden');
      
      if (headerGreeting) {
        headerGreeting.textContent = 'Catatan Ke Pasar Pintar';
      }
    }
  }

  // Listen to auth changes
  supabase.auth.onAuthStateChange((_event, session) => {
    renderSession(session);
  });

  // Login actions
  if (btnGoogle) {
    btnGoogle.addEventListener('click', async () => {
      try {
        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: { redirectTo: window.location.origin }
        });
        if (error) throw error;
      } catch (err) {
        if (typeof window.showToast === 'function') {
          window.showToast('Gagal masuk Google: ' + err.message, 'error');
        }
      }
    });
  }

  // Logout action
  if (btnLogout) {
    btnLogout.addEventListener('click', async () => {
      await supabase.auth.signOut();
    });
  }

  // Init
  checkSession();
</script>
