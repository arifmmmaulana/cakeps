---
---

<div class="history-manager">
  <div class="history-header">
    <h2>Riwayat Belanja</h2>
    <button id="history-toggle-btn" class="icon-btn" aria-label="Toggle history">
      <svg id="history-toggle-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
  </div>

  <div id="history-content-area" class="history-content hidden">
    <div id="history-loading" class="text-center text-muted" style="font-size: 0.9rem; padding: 1rem;">
      Memuat riwayat...
    </div>
    
    <div id="history-list-container" class="history-list hidden">
      <!-- List generated dynamically via JS -->
    </div>
  </div>
</div>

<style is:global>
  .history-manager {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.25rem;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .history-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .history-header h2 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .history-content {
    margin-top: 1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    width: 100%;
    margin-top: 0.5rem;
  }
  
  .history-row {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border-color-solid);
    gap: 0.5rem;
    transition: all var(--transition-fast);
  }
  .history-row:last-child {
    border-bottom: none;
  }
  .history-row:hover {
    background-color: var(--bg-surface-hover);
  }
  
  .history-row-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .history-icon {
    font-size: 1.2rem;
  }
  .history-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .history-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .history-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
  }
  .history-qty-badge {
    font-weight: 750;
    color: var(--text-secondary);
  }
  
  .history-price {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-primary);
    text-align: right;
    white-space: nowrap;
  }
  
  .history-row-details {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.25rem;
  }
  
  .history-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .btn-save-template {
    background: transparent;
    border: none;
    color: var(--color-brand);
    cursor: pointer;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    transition: all var(--transition-fast);
  }
  .btn-save-template:hover {
    background-color: var(--color-brand-light);
  }
  
  .btn-history-delete {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }
  .btn-history-delete:hover {
    background-color: var(--color-danger-light);
    color: var(--color-danger);
  }

</style>

<script>

  import { supabase } from "../lib/supabase";
  async function authFetch(url: string, options: any = {}) {
    const { data: { session } } = await supabase.auth.getSession();
    const token = session?.access_token;
    const headers = options.headers || {};
    if (token) headers['Authorization'] = `Bearer ${token}`;
    return fetch(url, { ...options, headers });
  }
  
  const toggleBtn = document.getElementById('history-toggle-btn');
  const toggleIcon = document.getElementById('history-toggle-icon');
  const contentArea = document.getElementById('history-content-area');
  const listContainer = document.getElementById('history-list-container');
  const loadingText = document.getElementById('history-loading');
  let cachedHistories = [];

  function formatRupiah(number) {
    return 'Rp ' + new Intl.NumberFormat('id-ID').format(number);
  }

  function formatDate(dateStr) {
    if (!dateStr) return '';
    try {
      const date = new Date(dateStr);
      return new Intl.DateTimeFormat('id-ID', {
        day: 'numeric', month: 'short', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
      }).format(date);
    } catch (e) {
      return dateStr;
    }
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = contentArea.classList.toggle('hidden');
      toggleIcon.classList.toggle('active', !isHidden);
      
      if (!isHidden) {
        fetchHistories();
      }
    });
  }

  async function fetchHistories() {
    loadingText.classList.remove('hidden');
    listContainer.classList.add('hidden');
    
    try {
      const res = await authFetch('/api/history');
      if (!res.ok) throw new Error();
      
      const histories = await res.json();
      cachedHistories = histories;
      
      if (histories.length === 0) {
        loadingText.textContent = 'Belum ada riwayat belanja yang tersimpan.';
        listContainer.innerHTML = '';
        return;
      }
      
      loadingText.classList.add('hidden');
      
      listContainer.innerHTML = histories.map(hist => {
        return `
          <div class="history-row" data-id="${hist.id}" style="cursor: pointer;">
            <div class="history-row-header">
              <span class="history-icon">🛒</span>
              <div class="history-info">
                <span class="history-name">${formatDate(hist.createdAt)}</span>
                <span class="history-meta"><span class="history-qty-badge">${hist.totalItems}</span> barang • Selesai dibelanjakan</span>
              </div>
              <div class="history-price">${formatRupiah(hist.totalActualPrice)}</div>
            </div>
            <div class="history-row-details">
              <div></div>
              <div class="history-actions">
                <button class="btn-save-template" aria-label="Simpan sebagai Template" data-id="${hist.id}">
                  Jadikan Template
                </button>
                <button class="btn-history-delete" aria-label="Hapus riwayat" data-id="${hist.id}">
                  🗑️
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      attachHistoryEvents();
      listContainer.classList.remove('hidden');
    } catch (error) {
      loadingText.textContent = 'Gagal memuat riwayat.';
    }
  }

  function attachHistoryEvents() {
    const rows = listContainer.querySelectorAll('.history-row');
    rows.forEach(row => {
      row.addEventListener('click', (e) => {
        if (e.target.closest('.btn-save-template') || e.target.closest('.btn-history-delete')) return;
        
        const id = row.dataset.id;
        const history = cachedHistories.find(h => h.id == id);
        if (history) {
          const pseudoTemplate = {
            name: 'Riwayat ' + formatDate(history.createdAt),
            items: history.items
          };
          // Call the identical preview function used by TemplateManager
          if (typeof window.showTemplatePreview === 'function') {
            window.showTemplatePreview(pseudoTemplate);
          }
        }
      });
    });

    const saveButtons = listContainer.querySelectorAll('.btn-save-template');
    saveButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = btn.dataset.id;
        
        const templateName = await window.showPrompt(
          'Simpan Riwayat sebagai Template',
          'Masukkan nama untuk template belanja ini:',
          'Misal: Belanja Mingguan'
        );

        if (templateName) {
          try {
            const res = await authFetch('/api/templates', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'create_from_history', historyId: id, name: templateName })
            });

            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Gagal menyimpan.');

            window.showToast(data.message || 'Template berhasil disimpan.');
            window.dispatchEvent(new CustomEvent('templates-updated'));
          } catch (err) {
            window.showToast(err.message, 'error');
          }
        }
      });
    });

    const deleteButtons = listContainer.querySelectorAll('.btn-history-delete');
    deleteButtons.forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = btn.dataset.id;
        
        const confirmDelete = await window.showConfirm(
          'Hapus Riwayat',
          'Apakah Anda yakin ingin menghapus riwayat belanja ini secara permanen?'
        );

        if (confirmDelete) {
          try {
            const res = await authFetch(`/api/history?id=${id}`, { method: 'DELETE' });
            if (!res.ok) throw new Error();
            
            window.showToast('Riwayat berhasil dihapus.');
            fetchHistories();
          } catch (err) {
            window.showToast('Gagal menghapus riwayat.', 'error');
          }
        }
      });
    });
  }

  // Listen for history updates globally (e.g. triggered when shopping finishes)
  window.addEventListener('history-updated', () => {
    if (!contentArea.classList.contains('hidden')) {
      fetchHistories();
    }
  });
</script>
