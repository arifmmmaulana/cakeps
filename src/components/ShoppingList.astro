---
import { Buffer } from 'node:buffer';
import { supabase } from '../lib/supabase';

// SSR: Fetch initial active and completed items list directly on the server
const { data = [] } = await supabase.from('items').select('*').order('created_at', { ascending: false });

const initialItems = (data || []).map(item => ({
  id: item.id,
  name: item.name,
  category: item.category,
  quantity: item.quantity,
  unit: item.unit,
  estimatedPrice: item.estimated_price,
  actualPrice: item.actual_price,
  checked: item.checked ? 1 : 0,
  createdAt: item.created_at
}));

// Group items on server
const activeItems = initialItems.filter(item => !item.checked);
const completedItems = initialItems.filter(item => item.checked);

const groupedActive = activeItems.reduce((acc: any, item: any) => {
  if (!acc[item.category]) acc[item.category] = [];
  acc[item.category].push(item);
  return acc;
}, {});

const categoryEmojis: Record<string, string> = {
  'Sayuran': '🥬',
  'Lauk/Daging': '🍗',
  'Bumbu': '🌶️',
  'Sembako': '🍚',
  'Laundry': '🧼',
  'Cemilan': '🍪',
  'Lain-lain': '📦'
};

function formatRupiah(number: number) {
  return 'Rp ' + new Intl.NumberFormat('id-ID').format(number);
}
---

<div id="shopping-list-container" class="mt-4" data-initial={Buffer.from(JSON.stringify(initialItems)).toString('base64')}>
  <!-- Live Search Bar -->
  <div class="search-wrapper">
    <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <input type="text" id="search-items-input" class="search-input" placeholder="Cari barang belanjaan..." autocomplete="off" />
  </div>

  <!-- Loading indicator (hidden by default since we SSR) -->
  <div id="list-loading" class="text-center p-4 hidden">Loading list...</div>
  
  <div id="list-content" class="animate-fade-in">
    {initialItems.length === 0 ? (
      <div class="empty-state animate-slide-up">
        <span class="empty-emoji">🥦</span>
        <h3>Keranjang Kosong</h3>
        <p class="mt-2">Catatan belanjaanmu masih kosong. Silakan ketik belanjaan baru di atas, atau muat template mingguan di bagian menu template!</p>
      </div>
    ) : (
      <>
        {Object.keys(groupedActive).sort().map(category => {
          const catItems = groupedActive[category];
          const emoji = categoryEmojis[category] || '📦';
          return (
            <div class="category-group" data-category={category}>
              <div class="category-header">
                <span class="category-title">{emoji} {category}</span>
                <span class="category-badge">{catItems.length} barang</span>
              </div>
              <div class="item-list">
                {catItems.map((item: any) => {
                  const itemSubtotal = item.quantity * item.estimatedPrice;
                  return (
                    <div class="item-row" data-id={item.id}>
                      <!-- Checkbox -->
                      <label class="checkbox-wrapper">
                        <input type="checkbox" class="item-checkbox" data-id={item.id} />
                        <span class="checkmark"></span>
                      </label>
                      
                      <!-- Info -->
                      <div class="item-details">
                        <span class="item-name-text">{item.name}</span>
                        <span class="item-meta">
                          <span class="item-qty-badge">{item.quantity} {item.unit}</span>
                          <span>•</span>
                          <span>Est: {formatRupiah(item.estimatedPrice)}/{item.unit}</span>
                        </span>
                      </div>
                      
                      <!-- Quick Qty Adjuster -->
                      <div class="item-control-area">
                        <div class="qty-adjuster">
                          <button class="qty-btn btn-minus" data-id={item.id} data-qty={item.quantity}>-</button>
                          <span class="qty-val">{item.quantity}</span>
                          <button class="qty-btn btn-plus" data-id={item.id} data-qty={item.quantity}>+</button>
                        </div>
                      </div>

                      <!-- Subtotal Price -->
                      <div class="item-price-area">
                        <span class="item-price-est">{formatRupiah(itemSubtotal)}</span>
                      </div>

                      <!-- Actions -->
                      <div class="item-actions">
                        <button class="btn-edit-item" data-id={item.id} title="Edit barang">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z"></path></svg>
                        </button>
                        <button class="btn-delete-item" data-id={item.id} title="Hapus barang">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}

        {completedItems.length > 0 && (
          <div class="category-group completed-section">
            <div class="completed-header">
              <span class="completed-title">✅ Selesai Dibelanjakan</span>
              <button class="btn-clear-completed" id="clear-completed-btn">Bersihkan</button>
            </div>
            <div class="item-list">
              {completedItems.map((item: any) => (
                <div class="item-row checked" data-id={item.id}>
                  <!-- Checked Checkbox -->
                  <label class="checkbox-wrapper">
                    <input type="checkbox" class="item-checkbox" data-id={item.id} checked />
                    <span class="checkmark"></span>
                  </label>
                  
                  <!-- Info -->
                  <div class="item-details">
                    <span class="item-name-text">{item.name}</span>
                    <span class="item-meta">
                      <span class="item-qty-badge">{item.quantity} {item.unit}</span>
                      <span>•</span>
                      <span>Est: {formatRupiah(item.estimatedPrice)}/{item.unit}</span>
                    </span>
                  </div>
                  
                  <!-- Actual Price Input -->
                  <div class="item-control-area">
                    <div class="actual-price-wrapper">
                      <span>Harga pas:</span>
                      <input 
                        type="number" 
                        class="actual-price-input" 
                        data-id={item.id} 
                        value={item.actualPrice || item.estimatedPrice} 
                        min="0"
                        step="500"
                      />
                    </div>
                  </div>

                  <!-- Empty Price Area for checked rows -->
                  <div class="item-price-area"></div>

                  <!-- Actions -->
                  <div class="item-actions">
                    <button class="btn-delete-item" data-id={item.id} title="Hapus barang">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </>
    )}
  </div>
</div>



<style is:global>
  /* Search Bar */
  .search-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: 1.5rem;
  }
  .search-icon {
    position: absolute;
    left: 1.15rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
    transition: color 0.2s;
  }
  .search-input {
    width: 100%;
    padding: 0.85rem 1.25rem 0.85rem 3.25rem;
    border-radius: 16px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.95rem;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s;
  }
  .search-input:focus {
    outline: none;
    border-color: var(--color-brand);
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15);
  }
  .search-input:focus + .search-icon,
  .search-wrapper:focus-within .search-icon {
    color: var(--color-brand);
  }

  /* Group layout styles */
  .category-group {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 18px;
    margin-bottom: 1.25rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .category-header {
    background-color: var(--bg-surface-hover);
    padding: 0.85rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color-solid);
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .category-title {
    font-size: 0.9rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
  }
  .category-badge {
    background-color: var(--color-brand-light);
    color: var(--color-brand);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 99px;
  }
  
  /* Item rows */
  .item-list {
    display: flex;
    flex-direction: column;
  }
  .item-row {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    grid-template-areas: 
      "check details actions"
      ". controls price";
    align-items: center;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border-color-solid);
    gap: 0.4rem 0.75rem;
    transition: all var(--transition-fast);
  }
  .item-row:last-child {
    border-bottom: none;
  }
  .item-row:hover {
    background-color: var(--bg-surface-hover);
  }
  
  /* Custom Checkbox */
  .checkbox-wrapper {
    grid-area: check;
    position: relative;
    width: 24px;
    height: 24px;
    cursor: pointer;
  }
  .checkbox-wrapper input {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }
  .checkmark {
    position: absolute;
    top: 0;
    left: 0;
    height: 24px;
    width: 24px;
    background-color: transparent;
    border: 2px solid var(--border-color-solid);
    border-radius: 50%;
    transition: all var(--transition-fast);
  }
  .checkbox-wrapper:hover input ~ .checkmark {
    border-color: var(--color-brand);
  }
  .checkbox-wrapper input:checked ~ .checkmark {
    background-color: var(--color-brand);
    border-color: var(--color-brand);
    animation: checkboxCheck 0.2s ease-out;
  }
  .checkmark:after {
    content: "";
    position: absolute;
    display: none;
  }
  .checkbox-wrapper input:checked ~ .checkmark:after {
    display: block;
  }
  .checkbox-wrapper .checkmark:after {
    left: 8px;
    top: 4px;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg);
  }
  
  /* Item text details */
  .item-details {
    grid-area: details;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .item-name-text {
    display: block;
    max-width: 100%;
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--transition-fast);
  }
  .item-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin-top: 0.15rem;
  }
  .item-qty-badge {
    font-weight: 750;
    color: var(--text-secondary);
  }
  
  /* Checked States */
  .item-row.checked {
    background-color: var(--bg-surface-hover);
  }
  .item-row.checked .item-name-text {
    text-decoration: line-through;
    color: var(--text-muted);
  }
  .item-row.checked .checkmark {
    background-color: var(--text-muted);
    border-color: var(--text-muted);
  }

  /* Inline Editing layout */
  .item-row.editing-row {
    background-color: var(--color-brand-light);
    border: 1.5px solid var(--color-brand);
    border-radius: 16px;
    padding: 1.25rem !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.85rem;
    margin: 0.25rem 0.5rem;
    box-shadow: var(--shadow-sm);
  }
  .edit-fields-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    width: 100%;
  }
  .edit-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .edit-field.full-width {
    grid-column: span 2;
  }
  .edit-field label {
    font-size: 0.7rem;
    font-weight: 750;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .edit-input {
    padding: 0.45rem 0.75rem !important;
    font-size: 0.85rem !important;
    border-radius: 8px !important;
    background-color: var(--bg-surface-solid) !important;
  }
  .edit-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    width: 100%;
    border-top: 1px solid var(--border-color);
    padding-top: 0.75rem;
  }
  .btn-save-edit, .btn-cancel-edit {
    background: transparent;
    border: none;
    cursor: pointer;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }
  .btn-save-edit {
    color: var(--color-brand);
    background-color: var(--color-brand-light);
  }
  .btn-save-edit:hover {
    background-color: var(--color-brand);
    color: white;
  }
  .btn-cancel-edit {
    color: var(--text-muted);
    background-color: var(--border-color-solid);
  }
  .btn-cancel-edit:hover {
    background-color: var(--text-secondary);
    color: white;
  }

  /* Quick Qty Adjuster */
  .item-control-area {
    grid-area: controls;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  .qty-adjuster {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--border-color-solid);
    border-radius: 8px;
    padding: 0.15rem 0.35rem;
  }
  .qty-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--color-brand);
    transition: all var(--transition-fast);
  }
  .qty-btn:hover {
    background-color: rgba(16, 185, 129, 0.15);
  }
  .qty-val {
    font-size: 0.8rem;
    font-weight: 750;
    min-width: 18px;
    text-align: center;
    color: var(--text-primary);
  }

  /* Actual Price Input when checked */
  .actual-price-wrapper {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 600;
  }
  .actual-price-input {
    width: 85px !important;
    padding: 0.3rem 0.5rem !important;
    font-size: 0.85rem !important;
    border-radius: 8px !important;
    height: auto !important;
    text-align: right;
    background-color: var(--bg-surface-solid) !important;
  }

  /* Price and Action Areas */
  .item-price-area {
    grid-area: price;
    text-align: right;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .item-actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
  }
  .btn-edit-item {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.3rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }
  .btn-edit-item:hover {
    color: var(--color-accent);
    background-color: var(--color-accent-light);
  }
  .btn-delete-item {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.3rem;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast);
  }
  .btn-delete-item:hover {
    color: var(--color-danger);
    background-color: var(--color-danger-light);
  }

  /* Completed Section */
  .completed-section {
    opacity: 0.9;
    margin-top: 1.5rem;
    border: 1px dashed var(--border-color-solid);
    background-color: transparent;
    border-radius: 18px;
  }
  .completed-header {
    padding: 0.85rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--border-color-solid);
  }
  .completed-title {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-clear-completed {
    font-size: 0.75rem;
    color: var(--color-danger);
    background: transparent;
    border: none;
    cursor: pointer;
    font-weight: 700;
    text-decoration: underline;
    transition: color var(--transition-fast);
  }
  .btn-clear-completed:hover {
    color: var(--color-danger-hover);
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 3.5rem 1.5rem;
    background-color: var(--bg-surface);
    border-radius: 20px;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
  }
  .empty-emoji {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    display: block;
    filter: drop-shadow(0 4px 10px rgba(16, 185, 129, 0.15));
  }
  .empty-state h3 {
    font-size: 1.1rem;
    font-weight: 750;
  }
  .empty-state p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Mobile Responsive adjustments to prevent overlap and optimize spacing */
  @media (max-width: 480px) {
    .category-header {
      padding: 0.75rem 1rem;
    }
    .category-title {
      font-size: 0.85rem;
      gap: 0.4rem;
    }
    .category-badge {
      font-size: 0.7rem;
      padding: 0.15rem 0.5rem;
    }
    .item-row {
      padding: 0.75rem 1rem;
      gap: 0.4rem 0.5rem;
    }
    .item-name-text {
      font-size: 0.9rem;
    }
    .item-meta {
      font-size: 0.7rem;
      gap: 0.2rem 0.4rem;
    }
    .qty-adjuster {
      padding: 0.1rem 0.25rem;
      gap: 0.25rem;
    }
    .qty-btn {
      width: 20px;
      height: 20px;
      font-size: 0.85rem;
    }
    .qty-val {
      font-size: 0.75rem;
      min-width: 14px;
    }
    .item-price-area {
      font-size: 0.8rem;
    }
    .actual-price-wrapper {
      font-size: 0.7rem;
      gap: 0.25rem;
    }
    .actual-price-input {
      width: 75px !important;
      padding: 0.25rem 0.4rem !important;
      font-size: 0.75rem !important;
    }
  }
</style>

<script>

  import { supabase } from "../lib/supabase";
  async function authFetch(url: string, options: any = {}) {
    const { data: { session } } = await supabase.auth.getSession();
    const token = session?.access_token;
    const headers = options.headers || {};
    if (token) headers['Authorization'] = `Bearer ${token}`;
    return fetch(url, { ...options, headers });
  }
  
  const container = document.getElementById('shopping-list-container');
  const loading = document.getElementById('list-loading');
  const content = document.getElementById('list-content');
  const searchInput = document.getElementById('search-items-input') as HTMLInputElement | null;

  // Category emojis mapping
  const categoryEmojis: Record<string, string> = {
    'Sayuran': '🥬',
    'Lauk/Daging': '🍗',
    'Bumbu': '🌶️',
    'Sembako': '🍚',
    'Laundry': '🧼',
    'Cemilan': '🍪',
    'Lain-lain': '📦'
  };

  // State Management
  const initialData = container?.dataset.initial;
  let currentItems: any[] = [];
  try {
    currentItems = initialData ? JSON.parse(atob(initialData)) : [];
  } catch (e) {
    console.error('Error parsing initial items data', e);
  }
  
  let editingItemId: number | null = null;
  let searchQuery = '';

  function formatRupiah(number: number) {
    return 'Rp ' + new Intl.NumberFormat('id-ID').format(number);
  }

  // Refresh data from the server, updates local state, and triggers UI re-render
  async function syncAndRenderItems() {
    if (loading) loading.classList.remove('hidden');
    try {
      const res = await authFetch('/api/items');
      if (!res.ok) throw new Error('Gagal mengambil data.');
      
      currentItems = await res.json();
      renderList();
    } catch (err: any) {
      console.error(err);
      (window as any).showToast('Gagal memuat daftar belanjaan: ' + err.message, 'error');
    } finally {
      if (loading) loading.classList.add('hidden');
    }
  }

  // Filter items in memory and render the list
  function renderList() {
    if (!content) return;

    // Trigger BudgetBar updates
    window.dispatchEvent(new CustomEvent('budget-data-updated', { detail: { items: currentItems } }));

    // Apply live search filter
    const filteredItems = currentItems.filter(item => 
      item.name.toLowerCase().includes(searchQuery)
    );

    if (filteredItems.length === 0) {
      renderEmptyState();
      return;
    }

    const activeItems = filteredItems.filter(item => !item.checked);
    const completedItems = filteredItems.filter(item => item.checked);

    // Group active items by category
    const groupedActive = activeItems.reduce((acc: any, item) => {
      if (!acc[item.category]) acc[item.category] = [];
      acc[item.category].push(item);
      return acc;
    }, {});

    let html = '';

    // Render active list categories
    Object.keys(groupedActive).sort().forEach(category => {
      const catItems = groupedActive[category];
      const emoji = categoryEmojis[category] || '📦';
      
      html += `
        <div class="category-group" data-category="${category}">
          <div class="category-header">
            <span class="category-title">${emoji} ${category}</span>
            <span class="category-badge">${catItems.length} barang</span>
          </div>
          <div class="item-list">
            ${catItems.map((item: any) => renderItemRow(item)).join('')}
          </div>
        </div>
      `;
    });

    // Render completed section
    if (completedItems.length > 0) {
      html += `
        <div class="category-group completed-section">
          <div class="completed-header">
            <span class="completed-title">✅ Selesai Dibelanjakan</span>
            <button class="btn-clear-completed" id="clear-completed-btn">Bersihkan</button>
          </div>
          <div class="item-list">
            ${completedItems.map((item: any) => renderItemRow(item)).join('')}
          </div>
        </div>
      `;
    }

    content.innerHTML = html;
    attachEventListeners();
  }

  // Renders a single row item (normal or edit mode)
  function renderItemRow(item: any): string {
    const isChecked = item.checked === 1;
    const isEditing = editingItemId === item.id;
    const itemSubtotal = item.quantity * item.estimatedPrice;

    // Edit Mode Template
    if (isEditing) {
      return `
        <div class="item-row editing-row" data-id="${item.id}">
          <div class="edit-fields-grid">
            <div class="edit-field full-width">
              <label>Nama Barang</label>
              <input type="text" class="edit-input edit-name" value="${item.name}" required />
            </div>
            
            <div class="edit-field">
              <label>Kategori</label>
              <select class="edit-input edit-category">
                <option value="Sayuran" ${item.category === 'Sayuran' ? 'selected' : ''}>🥬 Sayuran</option>
                <option value="Lauk/Daging" ${item.category === 'Lauk/Daging' ? 'selected' : ''}>🍗 Lauk/Daging</option>
                <option value="Bumbu" ${item.category === 'Bumbu' ? 'selected' : ''}>🌶️ Bumbu</option>
                <option value="Sembako" ${item.category === 'Sembako' ? 'selected' : ''}>🍚 Sembako</option>
                <option value="Laundry" ${item.category === 'Laundry' ? 'selected' : ''}>🧼 Laundry</option>
                <option value="Cemilan" ${item.category === 'Cemilan' ? 'selected' : ''}>🍪 Cemilan</option>
                <option value="Lain-lain" ${item.category === 'Lain-lain' ? 'selected' : ''}>📦 Lain-lain</option>
              </select>
            </div>

            <div class="edit-field">
              <label>Jumlah</label>
              <input type="number" class="edit-input edit-qty" value="${item.quantity}" min="0.1" step="any" required />
            </div>

            <div class="edit-field">
              <label>Satuan</label>
              <select class="edit-input edit-unit">
                <option value="pcs" ${item.unit === 'pcs' ? 'selected' : ''}>pcs</option>
                <option value="ikat" ${item.unit === 'ikat' ? 'selected' : ''}>ikat</option>
                <option value="kg" ${item.unit === 'kg' ? 'selected' : ''}>kg</option>
                <option value="g" ${item.unit === 'g' ? 'selected' : ''}>gram</option>
                <option value="bungkus" ${item.unit === 'bungkus' ? 'selected' : ''}>bungkus</option>
                <option value="buah" ${item.unit === 'buah' ? 'selected' : ''}>buah</option>
                <option value="papan" ${item.unit === 'papan' ? 'selected' : ''}>papan</option>
                <option value="liter" ${item.unit === 'liter' ? 'selected' : ''}>liter</option>
                <option value="botol" ${item.unit === 'botol' ? 'selected' : ''}>botol</option>
                <option value="sachet" ${item.unit === 'sachet' ? 'selected' : ''}>sachet</option>
              </select>
            </div>

            <div class="edit-field">
              <label>Harga Est. (Rp)</label>
              <input type="number" class="edit-input edit-price" value="${item.estimatedPrice}" min="0" step="500" />
            </div>
          </div>
          <div class="edit-actions">
            <button class="btn-save-edit" data-id="${item.id}" title="Simpan perubahan">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
            <button class="btn-cancel-edit" title="Batal">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
          </div>
        </div>
      `;
    }

    // Normal Row Template (Interactive Controls & Quick Adjuster)
    return `
      <div class="item-row ${isChecked ? 'checked' : ''}" data-id="${item.id}">
        <!-- Checkbox -->
        <label class="checkbox-wrapper">
          <input type="checkbox" class="item-checkbox" data-id="${item.id}" ${isChecked ? 'checked' : ''}>
          <span class="checkmark"></span>
        </label>
        
        <!-- Info -->
        <div class="item-details">
          <span class="item-name-text">${item.name}</span>
          <span class="item-meta">
            <span class="item-qty-badge">${item.quantity} ${item.unit}</span>
            <span>•</span>
            <span>Est: ${formatRupiah(item.estimatedPrice)}/${item.unit}</span>
          </span>
        </div>
        
        <!-- Interactive Control Area -->
        <div class="item-control-area">
          ${isChecked ? `
            <div class="actual-price-wrapper">
              <span>Harga pas:</span>
              <input 
                type="number" 
                class="actual-price-input" 
                data-id="${item.id}" 
                value="${item.actualPrice || item.estimatedPrice * item.quantity}" 
                min="0"
                step="500"
              />
            </div>
          ` : `
            <div class="qty-adjuster">
              <button class="qty-btn btn-minus" data-id="${item.id}" data-qty="${item.quantity}">-</button>
              <span class="qty-val">${item.quantity}</span>
              <button class="qty-btn btn-plus" data-id="${item.id}" data-qty="${item.quantity}">+</button>
            </div>
          `}
        </div>

        <!-- Subtotal Area -->
        <div class="item-price-area">
          ${isChecked ? '' : `<span class="item-price-est">${formatRupiah(itemSubtotal)}</span>`}
        </div>

        <!-- Action Panel -->
        <div class="item-actions">
          ${isChecked ? '' : `
            <button class="btn-edit-item" data-id="${item.id}" title="Edit barang">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4z"></path></svg>
            </button>
          `}
          <button class="btn-delete-item" data-id="${item.id}" title="Hapus barang">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
          </button>
        </div>
      </div>
    `;
  }

  function renderEmptyState() {
    if (!content) return;
    
    content.innerHTML = `
      <div class="empty-state animate-slide-up">
        <span class="empty-emoji">🥦</span>
        <h3>Barang Tidak Ditemukan</h3>
        <p class="mt-2">Tidak ada barang belanjaan aktif yang cocok dengan kata kunci "${searchQuery}".</p>
      </div>
    `;
    window.dispatchEvent(new CustomEvent('budget-data-updated', { detail: { items: currentItems } }));
  }

  function attachEventListeners() {
    if (!content) return;

    // Checkbox toggles
    const checkboxes = content.querySelectorAll('.item-checkbox');
    checkboxes.forEach(cb => {
      cb.addEventListener('change', async (e: any) => {
        const id = e.target.dataset.id;
        const checked = e.target.checked;
        
        try {
          const res = await authFetch('/api/items', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, checked })
          });
          
          if (!res.ok) throw new Error();
          
          await syncAndRenderItems();
          (window as any).showToast(checked ? 'Barang selesai dibeli!' : 'Barang dikembalikan ke keranjang.', 'info');
        } catch (err) {
          (window as any).showToast('Gagal memperbarui status barang.', 'error');
          e.target.checked = !checked; // revert
        }
      });
    });

    // Actual price inputs
    const priceInputs = content.querySelectorAll('.actual-price-input');
    priceInputs.forEach(input => {
      input.addEventListener('change', async (e: any) => {
        const id = e.target.dataset.id;
        const actualPrice = parseInt(e.target.value) || 0;

        try {
          const res = await authFetch('/api/items', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, actualPrice })
          });
          
          if (!res.ok) throw new Error();
          
          await syncAndRenderItems();
        } catch (err) {
          (window as any).showToast('Gagal memperbarui harga aktual.', 'error');
        }
      });
    });

    // Quick Qty Plus Adjuster
    const plusButtons = content.querySelectorAll('.qty-adjuster .btn-plus');
    plusButtons.forEach(btn => {
      btn.addEventListener('click', async (e: any) => {
        const id = e.target.dataset.id;
        const oldQty = parseFloat(e.target.dataset.qty) || 1;
        const newQty = oldQty < 1 ? Math.round((oldQty + 0.1) * 10) / 10 : oldQty + 1;

        try {
          const res = await authFetch('/api/items', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, quantity: newQty })
          });
          
          if (!res.ok) throw new Error();
          await syncAndRenderItems();
        } catch (err) {
          (window as any).showToast('Gagal memperbarui jumlah.', 'error');
        }
      });
    });

    // Quick Qty Minus Adjuster
    const minusButtons = content.querySelectorAll('.qty-adjuster .btn-minus');
    minusButtons.forEach(btn => {
      btn.addEventListener('click', async (e: any) => {
        const id = e.target.dataset.id;
        const oldQty = parseFloat(e.target.dataset.qty) || 1;
        
        if (oldQty <= 0.1) {
          return; // Minimum limit
        }
        
        const newQty = oldQty <= 1 
          ? Math.round((oldQty - 0.1) * 10) / 10 
          : oldQty - 1;

        try {
          const res = await authFetch('/api/items', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, quantity: Math.max(0.1, newQty) })
          });
          
          if (!res.ok) throw new Error();
          await syncAndRenderItems();
        } catch (err) {
          (window as any).showToast('Gagal memperbarui jumlah.', 'error');
        }
      });
    });

    // Edit button clicks (enter edit mode)
    const editBtns = content.querySelectorAll('.btn-edit-item');
    editBtns.forEach(btn => {
      btn.addEventListener('click', (e: any) => {
        const button = e.target.closest('.btn-edit-item');
        editingItemId = parseInt(button.dataset.id) || null;
        renderList();
      });
    });

    // Cancel edit clicks
    const cancelEditBtns = content.querySelectorAll('.btn-cancel-edit');
    cancelEditBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        editingItemId = null;
        renderList();
      });
    });

    // Save edit clicks
    const saveEditBtns = content.querySelectorAll('.btn-save-edit');
    saveEditBtns.forEach(btn => {
      btn.addEventListener('click', async (e: any) => {
        const button = e.target.closest('.btn-save-edit');
        const id = button.dataset.id;
        const row = button.closest('.editing-row');
        
        const nameInput = row.querySelector('.edit-name') as HTMLInputElement;
        const categorySelect = row.querySelector('.edit-category') as HTMLSelectElement;
        const qtyInput = row.querySelector('.edit-qty') as HTMLInputElement;
        const unitSelect = row.querySelector('.edit-unit') as HTMLSelectElement;
        const priceInput = row.querySelector('.edit-price') as HTMLInputElement;

        const name = nameInput.value.trim();
        const category = categorySelect.value;
        const quantity = parseFloat(qtyInput.value) || 1;
        const unit = unitSelect.value;
        const estimatedPrice = parseInt(priceInput.value) || 0;

        if (!name) {
          (window as any).showToast('Nama barang tidak boleh kosong.', 'error');
          return;
        }

        try {
          const res = await authFetch('/api/items', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id,
              name,
              category,
              quantity,
              unit,
              estimatedPrice
            })
          });

          if (!res.ok) throw new Error();
          
          editingItemId = null;
          (window as any).showToast('Barang berhasil diperbarui!');
          await syncAndRenderItems();
        } catch (err) {
          (window as any).showToast('Gagal memperbarui detail barang.', 'error');
        }
      });
    });

    // Delete buttons
    const deleteBtns = content.querySelectorAll('.btn-delete-item');
    deleteBtns.forEach(btn => {
      btn.addEventListener('click', async (e: any) => {
        const button = e.target.closest('.btn-delete-item');
        const id = button.dataset.id;

        const confirmDelete = await (window as any).showConfirm(
          'Hapus Barang',
          'Apakah Anda yakin ingin menghapus barang ini dari catatan belanja?'
        );

        if (confirmDelete) {
          try {
            const res = await authFetch(`/api/items?id=${id}`, {
              method: 'DELETE'
            });

            if (!res.ok) throw new Error();

            (window as any).showToast('Barang berhasil dihapus.');
            await syncAndRenderItems();
          } catch (err) {
            (window as any).showToast('Gagal menghapus barang.', 'error');
          }
        }
      });
    });

    // Clear completed button
    const clearCompletedBtn = document.getElementById('clear-completed-btn');
    if (clearCompletedBtn) {
      clearCompletedBtn.addEventListener('click', async () => {
        const confirmClear = await (window as any).showConfirm(
          'Bersihkan Barang',
          'Apakah Anda yakin ingin membersihkan seluruh barang yang sudah selesai dibeli?'
        );

        if (confirmClear) {
          try {
            const res = await authFetch('/api/items?clearChecked=true', {
              method: 'DELETE'
            });

            if (!res.ok) throw new Error();

            (window as any).showToast('Keranjang belanja dibersihkan.');
            await syncAndRenderItems();
          } catch (err) {
            (window as any).showToast('Gagal membersihkan keranjang.', 'error');
          }
        }
      });
    }
  }

  // Handle live search
  if (searchInput) {
    searchInput.addEventListener('input', (e: any) => {
      searchQuery = e.target.value.toLowerCase().trim();
      renderList();
    });
  }

  // Listen for items-updated (dispatched by other components, e.g. AddItemForm)
  window.addEventListener('items-updated', () => {
    syncAndRenderItems();
  });

  // Initial event bindings on page load (progressive enhancement)
  attachEventListeners();
  
  // Fetch initial data from server to populate authenticated items
  syncAndRenderItems();
</script>
